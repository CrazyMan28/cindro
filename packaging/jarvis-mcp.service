[Unit]
Description=Jarvis-MCP server (Jarvis Contract-A + computer-use, one MCP endpoint)
# It fronts jarvisd's control WS and the computer-use engine; start after both
# so the re-export + control ping succeed on first poll. Wants (not Requires)
# keeps it degraded-but-up if a dependency is briefly down.
Wants=jarvisd.service computer-use-mcp.service
After=jarvisd.service computer-use-mcp.service network-online.target

[Service]
# jarvis-mcp reads ~/.config/jarvis/{control_token,jarvis_mcp_token} (the
# inbound token is auto-generated 0600 on first start) and
# ~/.computer-use/config.yaml (computer-use bearer for the re-export). It binds
# 0.0.0.0:8797 (tailnet bearer model). Run from the project's uv venv.
#
# Set %h/projects/computer_use/jarvis-mcp as the working dir; `uv run` resolves
# the venv there. PYTHONPATH is unset because the host exports a 3.14 PYTHONPATH
# that breaks venvs (see computer_use README).
WorkingDirectory=%h/projects/computer_use/jarvis-mcp
Environment=PYTHONPATH=
ExecStart=/usr/bin/env -u PYTHONPATH uv run jarvis-mcp
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
