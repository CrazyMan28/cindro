[Unit]
Description=Jarvis daemon

[Service]
# %h expands to the user's home directory. jarvisd reads
# ~/.config/jarvis/{config.toml,control_token} (auto-generating the 0600
# control_token on first start, per Contract A) and writes
# ~/.local/share/jarvis/jarvis.db. It runs headless, so force the offscreen
# Qt platform plugin.
ExecStart=%h/.local/bin/jarvisd
Restart=on-failure
RestartSec=2
Environment=QT_QPA_PLATFORM=offscreen

[Install]
WantedBy=default.target
