# Jarvis — mako notification config.
# Install: copy to ~/.config/mako/config, then `makoctl reload` (or restart mako).
# Jarvis posts desktop notifications (approval requests, session finished, push
# relays) under the app-name "jarvis".

# --- Global defaults -------------------------------------------------------
max-visible=5
sort=-time
layer=overlay
anchor=top-right
default-timeout=8000
ignore-timeout=0

font=monospace 11
width=420
height=160
margin=12
padding=12,16
border-size=1
border-radius=12

background-color=#0c1020f0
text-color=#e8f4ff
border-color=#22e0ff
progress-color=over #b14bff

# --- App-scoped rules ------------------------------------------------------
[app-name=jarvis]
group-by=summary
border-color=#22e0ff

# Approval requests are urgent and must not auto-dismiss until acted on.
[app-name=jarvis urgency=critical]
border-color=#ff2d95
text-color=#ff2d95
default-timeout=0
ignore-timeout=1

# Low-priority status pings (e.g. "session finished") fade quickly.
[app-name=jarvis urgency=low]
border-color=#2dffb0
default-timeout=4000
