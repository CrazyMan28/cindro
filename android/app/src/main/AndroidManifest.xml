<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pairing + Contract C device WebSocket (ws://<laptop>:8796) need the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- POST_NOTIFICATIONS is runtime-requested on API 33+ for FCM alerts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- QR pairing scans with CameraX; camera is optional (manual entry fallback). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Voice: record audio for push-to-talk + "Hey Cindro" wake. The wake listener
         runs only while a foreground service + notification is visible. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Background connection service: keeps the daemon WebSocket alive so we can post
         local notifications WITHOUT Firebase (no FCM service account in this setup). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Subtle haptic feedback in chat (send tick, streaming micro-ticks, completion). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ===== Vendored Agent Phone (com.agentphone.*) permissions =====
         Verbatim from agent-phone's manifest; the ones Jarvis already declares
         (INTERNET, RECORD_AUDIO, POST_NOTIFICATIONS, FOREGROUND_SERVICE,
         FOREGROUND_SERVICE_MICROPHONE) are not repeated. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Relay PUCK mode: legacy Bluetooth perms for HFP-HF proxy on pre-Android-12 devices. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <application
        android:name=".JarvisApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jarvis">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Jarvis"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Debug design-preview activity (renders Home with sample data, no pairing).
             Launched only via adb for screenshots; not in the launcher. -->
        <activity
            android:name=".ui.PreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.Jarvis" />

        <!-- FCM receiver: data-only pushes from jarvisd (project "the FCM project"). -->
        <service
            android:name=".fcm.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- "Hey Cindro" wake: foreground (microphone) service with a persistent
             notification. No silent background listening — the notification is the
             user's visible signal that the mic is live. -->
        <service
            android:name=".voice.WakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Background connection: holds the daemon device WS open and posts local
             notifications (new session, file offer) over it — the no-Firebase path. -->
        <service
            android:name=".net.JarvisConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Real home-screen widget: renders a pinned Jarvis canvas/widget (drawn to
             a bitmap) and updates live over the device WS (push-driven, no polling). -->
        <receiver
            android:name=".widget.JarvisWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.jarvis.app.WIDGET_PINNED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jarvis_appwidget_info" />
        </receiver>

        <!-- Size-tier siblings: same provider behavior, different default cell, so a
             widget can be pinned at a size that fits its content (Android has no
             per-pin size API). WidgetPinHelper picks one by the content's height. -->
        <receiver android:name=".widget.JarvisWidgetCompactProvider" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.jarvis.app.WIDGET_PINNED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/jarvis_appwidget_info_compact" />
        </receiver>
        <receiver android:name=".widget.JarvisWidgetTallProvider" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.jarvis.app.WIDGET_PINNED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/jarvis_appwidget_info_tall" />
        </receiver>
        <receiver android:name=".widget.JarvisWidgetXTallProvider" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.jarvis.app.WIDGET_PINNED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/jarvis_appwidget_info_xtall" />
        </receiver>

        <!-- Config screen shown when the widget is added from the OS picker (the
             in-app 1-click pin skips it). Launched by the launcher, so exported. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Jarvis">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- FileProvider so file.offer downloads can be opened/shared by other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ===================================================================
             Vendored Agent Phone (com.agentphone.*) — full original app embedded
             in this one APK. Activities/services/receiver are declared with their
             fully-qualified names so they coexist with Jarvis's own components.
             MainActivity is NOT a launcher here (Jarvis's MainActivity is the only
             launcher); Jarvis's Phone tab starts it via an explicit Intent.
             ==================================================================== -->
        <activity
            android:name="com.agentphone.MainActivity"
            android:exported="false"
            android:label="Agent Phone"
            android:theme="@style/AgentPhoneAppTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.agentphone.IncomingCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showOnLockScreen="true"
            android:theme="@style/AgentPhoneAppTheme"
            android:turnScreenOn="true" />
        <activity
            android:name="com.agentphone.OutgoingCallActivity"
            android:exported="false"
            android:label="Calling"
            android:launchMode="singleTop"
            android:theme="@style/AgentPhoneAppTheme" />
        <activity
            android:name="com.agentphone.ScreeningActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="Call screening"
            android:launchMode="singleTop"
            android:showOnLockScreen="true"
            android:theme="@style/AgentPhoneAppTheme"
            android:turnScreenOn="true" />
        <receiver
            android:name="com.agentphone.service.BootCompletedReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service
            android:name="com.agentphone.service.AgentPhoneForegroundService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />
        <service
            android:name="com.agentphone.service.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name="com.agentphone.puck.RelayPuckService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name="com.agentphone.service.AgentPhoneConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
        <service
            android:name="com.agentphone.service.AgentCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="jarvis_updates" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/jarvis_accent" />

    </application>

</manifest>
