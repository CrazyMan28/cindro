<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pairing + Contract C device WebSocket (ws://<laptop>:8796) need the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- POST_NOTIFICATIONS is runtime-requested on API 33+ for FCM alerts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- QR pairing scans with CameraX; camera is optional (manual entry fallback). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Voice: record audio for push-to-talk + "Hey Jarvis" wake. The wake listener
         runs only while a foreground service + notification is visible. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Subtle haptic feedback in chat (send tick, streaming micro-ticks, completion). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".JarvisApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jarvis">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Jarvis"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM receiver: data-only pushes from jarvisd (project "baratone"). -->
        <service
            android:name=".fcm.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- "Hey Jarvis" wake: foreground (microphone) service with a persistent
             notification. No silent background listening — the notification is the
             user's visible signal that the mic is live. -->
        <service
            android:name=".voice.WakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- FileProvider so file.offer downloads can be opened/shared by other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="jarvis_updates" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/jarvis_accent" />

    </application>

</manifest>
