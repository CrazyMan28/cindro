<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      Do not back up the encrypted secret store: its AndroidKeyStore master key is
      device-bound and would not be restorable on another device.
    -->
    <exclude domain="sharedpref" path="jarvis_secret_store.xml" />
    <!--
      Also exclude the plain (unencrypted) fallback file used when the
      AndroidKeyStore master key can't be minted — it holds the same raw
      Ed25519 seed / device secrets, just not AES-GCM wrapped.
    -->
    <exclude domain="sharedpref" path="jarvis_secret_store_plain.xml" />
</full-backup-content>
