<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview tile. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0E2233" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#1F3A4D" />
        </shape>
    </item>
    <item android:gravity="center" android:width="48dp" android:height="48dp">
        <bitmap android:src="@drawable/ic_launcher_foreground" android:tint="#5FE0FF" />
    </item>
</layer-list>
