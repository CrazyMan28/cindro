# --- C++ / CMake build artifacts ---
build/
build-*/
*.o
CMakeCache.txt
CMakeFiles/
**/build/

# --- Python ---
.venv/
__pycache__/
*.pyc

# --- Voice clone source/output (copyrighted source clips; generated audio) ---
# Reference clips live in ~/.config/jarvis/voices/, never in the repo. Keep any
# stray source recordings / generated samples out of git.
Screen_Recording_*.mp3
jarvice_*.wav
jarvice_*.mp3

# --- Node / web ---
node_modules/

# --- Phone subsystem (vendored agent-phone server): build + runtime state ---
phone/server/dist/
phone/server/*.sqlite
phone/server/*.sqlite-*
phone/server/data/local-voices/
phone/**/.env
phone/server/tmp/
# Per-machine agent config (absolute paths/accounts). Ship agents.config.example.json.
phone/server/agents.config.json

# --- Android / Gradle ---
*.apk
*.aab
.gradle/
local.properties
# Firebase config holds a project API key — keep it local. Ship google-services.json.example.
android/app/google-services.json

# --- Secrets (NEVER commit) ---
*.token
service-account*.json
.env

# --- Plugin publisher PRIVATE keys (public .pub may be committed) ---
plugins/keys/*.key
*.privkey

# --- Packed plugin tarballs (built artifacts, re-creatable via `pack`) ---
plugins/**/*.tar.gz

# --- Logs ---
*.log

# --- CTest run artifacts + scratch test venvs ---
Testing/
.venv_test/
computer-use/.venv_test/

# Android: vendored sherpa-onnx AAR (on-device TTS, ~56MB, re-fetch locally)
android/app/libs/*.aar
