# --- C++ / CMake build artifacts ---
build/
build-*/
*.o
CMakeCache.txt
CMakeFiles/
**/build/

# --- Python ---
.venv/
__pycache__/
*.pyc

# --- Node / web ---
node_modules/

# --- Android / Gradle ---
*.apk
*.aab
.gradle/
local.properties

# --- Secrets (NEVER commit) ---
*.token
service-account*.json
.env

# --- Plugin publisher PRIVATE keys (public .pub may be committed) ---
plugins/keys/*.key
*.privkey

# --- Packed plugin tarballs (built artifacts, re-creatable via `pack`) ---
plugins/**/*.tar.gz

# --- Logs ---
*.log
